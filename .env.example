# ---- Copy to .env.local (and to your production environment) -------------
# All NEXT_PUBLIC_* values are exposed to the browser — keep anon keys only.

# Supabase project URL + anon key (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL — used for password-reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: require TOTP on admin login (enrol a factor in /admin/account first).
REQUIRE_MFA=false

# Optional: Cloudflare Turnstile on the login form. Leave both unset to disable.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# ---- Scripts only (never exposed) -----------------------------------------
# Service-role key: used by `npm run db:seed`. Never add to .env.local for
# the app itself, and never ship it to the client or Vercel preview builds.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key