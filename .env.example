# ---- Copy to .env.local (and to your production environment) -------------
# All NEXT_PUBLIC_* values are exposed to the browser - keep anon keys only.
#
# This file contains EMPTY values only, by policy: nothing here may ever look
# like a real credential. Every variable below has a code-level fallback or an
# obvious default; fill in real values in .env.local, never in this file.

# Supabase project URL + publishable/anon key (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL - used for password-reset redirects.
# Unset / empty falls back to http://localhost:3000 in src/app/login/actions.ts.
NEXT_PUBLIC_SITE_URL=

# Optional: require TOTP on admin login (enrol a factor in /admin/account first).
# Empty is treated as false; set the exact string "true" to enforce.
REQUIRE_MFA=

# Optional: Cloudflare Turnstile on the login form. Leave both unset to disable.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# ---- Scripts only (never exposed) -----------------------------------------
# Service-role key: used by `npm run db:seed -- --push`. Put it in
# .env.seed.local (gitignored) - NEVER in .env.local, and never here.
# npm run check:supabase fails if this key appears in .env.local.
SUPABASE_SERVICE_ROLE_KEY=
